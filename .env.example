# Copiază în .env (care NU se urcă pe GitHub) și completează ce ai nevoie.

# --- backend ---
DEFAULT_REGION=RO              # regiunea pentru localhost / când geolocația eșuează (trebuie să fie în MARKETS)
MARKETS=US,RO,JP,GB,DE,FR,IT,ES,NL,BE,PL,SE,AT,PT,GR   # țările din selector; IP-ul e mapat pe cea mai apropiată
GEO_ENABLED=true               # false = fără apeluri la ip-api.com
GEO_TIMEOUT=1.5
CORS_ORIGINS=*                 # ex: http://localhost:5173
# PIPELINE_PYTHON=.venv/Scripts/python.exe   # python-ul cu care rulează motorul

# --- task 2: generare imagini ---
IMAGE_API_KEY=
