# Python (the venv lives in backend/.venv, created by backend/start.py)
.venv/
__pycache__/
*.pyc

# secrets (API keys)
.env

# rendered results and large media (regenerate with the pipeline)
backend/output/*
# ...except the 9 s Melbourne demo the frontend plays (repo is private: real brand ads stay in the team)
!backend/output/melbourne.manifest.json
!backend/output/melbourne.scene.json
!backend/output/melbourne.surfaces.json
!backend/output/melbourne_original.mp4
!backend/output/melbourne_ro.mp4
!backend/output/melbourne_jp.mp4
!backend/output/melbourne_ai_view.mp4
!backend/output/melbourne_compare.mp4
!backend/output/melbourne_creatives/
backend/assets/clips/*.mp4
backend/assets/clips/*.mov

# real brand ads: used only for the demo, not redistributed (re-download from creative_source in backend/data/ads.json)
backend/data/creatives/

# cache of AI-expanded creatives (regenerated by run.py; the final ones land in output/<clip>_creatives/)
backend/assets/generated/

# model weights downloaded at runtime (YOLO and SAM 2 go to backend/models/)
*.pt
backend/models/

# test cache
.pytest_cache/

# frontend build output
frontend/dist/
