# Python
.venv/
__pycache__/
*.pyc

# secrets (API keys)
.env

# rendered results and large media (regenerate with the pipeline)
output/*
# ...except the 9 s Melbourne demo the frontend plays (repo is private: real brand ads stay in the team)
!output/melbourne.manifest.json
!output/melbourne.scene.json
!output/melbourne.surfaces.json
!output/melbourne_original.mp4
!output/melbourne_ro.mp4
!output/melbourne_jp.mp4
!output/melbourne_ai_view.mp4
!output/melbourne_compare.mp4
!output/melbourne_creatives/
assets/clips/*.mp4
assets/clips/*.mov

# real brand ads: used only for the demo, not redistributed (re-download from creative_source in data/ads.json)
data/creatives/

# cache of AI-expanded creatives (regenerated by run.py; the final ones land in output/<clip>_creatives/)
assets/generated/

# model weights downloaded at runtime
*.pt

# test cache
.pytest_cache/
