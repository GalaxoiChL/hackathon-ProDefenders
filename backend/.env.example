# Copiază în backend/.env (care NU se urcă pe GitHub) și completează ce ai nevoie.

# --- backend ---
DEFAULT_REGION=RO              # regiunea pentru localhost / când geolocația eșuează (trebuie să fie în MARKETS)
MARKETS=US,RO,JP,GB,DE,FR,IT,ES,NL,BE,PL,SE,AT,PT,GR   # țările din selector; IP-ul e mapat pe cea mai apropiată
GEO_ENABLED=true               # false = fără apeluri la ip-api.com
GEO_TIMEOUT=1.5
CORS_ORIGINS=*                 # ex: http://localhost:5173
# PIPELINE_PYTHON=backend/.venv/Scripts/python.exe   # python-ul cu care rulează motorul (implicit: cel al serverului)

# --- prospectare advertiseri (backend/outreach) ---
PUBLIC_BASE_URL=http://localhost:8000      # adresa din linkurile de licitație / dezabonare
SECRET_KEY=                                # semnează linkurile; gol = generată și păstrată în output/outreach.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
BRAVE_API_KEY=                             # opțional: căutare web suplimentară
OUTREACH_SEND_ENABLED=false                # true = trimite chiar (altfel doar output/outbox/*.eml)
OUTREACH_TEST_RECIPIENT=                   # demo: TOATE emailurile merg aici
OUTREACH_DAILY_LIMIT=20
OUTREACH_SENDER_NAME=ProDefenders
OUTREACH_SENDER_COMPANY=ProDefenders (ITFest 2026 demo)
OUTREACH_SENDER_ADDRESS=București, România
SMTP_HOST=smtp.gmail.com                   # Gmail: cont cu 2FA + „App password”
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- task 2: generare imagini ---
IMAGE_API_KEY=
